# Build output
build/
build-*/
out/

# Anything a running Verguenza writes. A vault is never committed, real or test.
*.vault
*.verguenza
vaults/
identity/
*.key
*.sealed

# Correspondence with sibling projects: relayed by the author, folded into the log
MESSAGE_FOR_*.md

# Editors
.vs/
.vscode/
*.swp

# Never published (Void Mago's Iscariot): secrets, correspondence between
# agents, and the private-terms list.
.env
git_secret.txt
KEEP_HIDDEN.txt
*.pem
REPORT_FROM_*.md
.private-terms
.claude/settings.local.json
